{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ersona",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "ersona"
    }
  ]
}
